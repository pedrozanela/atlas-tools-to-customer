# ============================================================================
# Atlas — Local Development Environment
# ============================================================================
# Copy this file to .env.local and fill in the secrets. .env.local is gitignored.
#
# Database: Lakebase Autoscaling instance `databricks-atlas` on workspace adb-brazil.
# Schemas: forge, waf, tap (one per module).
# ============================================================================

# --- Database -----------------------------------------------------------------
# Pooled URL (PgBouncer) — used by the app at runtime.
DATABASE_URL="postgresql://atlas-admin:<PASSWORD>@ep-young-darkness-e5p0ng50-pooler.database.brazilsouth.azuredatabricks.net/databricks_postgres?sslmode=require"

# Unpooled URL — required by Prisma for migrations (`prisma db push`, `migrate dev`).
DATABASE_URL_UNPOOLED="postgresql://atlas-admin:<PASSWORD>@ep-young-darkness-e5p0ng50.database.brazilsouth.azuredatabricks.net/databricks_postgres?sslmode=require"

# --- Databricks workspace (for SDK calls in dev) ------------------------------
DATABRICKS_HOST="https://adb-6313129442315904.4.azuredatabricks.net"
# Use Databricks CLI profile `adb-brazil` for OAuth (recommended).
# For PAT-based auth uncomment below and set the token.
# DATABRICKS_TOKEN=""
DATABRICKS_CONFIG_PROFILE="adb-brazil"

# SQL Warehouse to use for customer queries.
DATABRICKS_WAREHOUSE_ID=""

# --- Model serving endpoints --------------------------------------------------
DATABRICKS_SERVING_ENDPOINT="databricks-claude-opus-4-7"
DATABRICKS_SERVING_ENDPOINT_FAST="databricks-claude-sonnet-4-6"
DATABRICKS_EMBEDDING_ENDPOINT="databricks-qwen3-embedding-0-6b"

# --- App config ---------------------------------------------------------------
NODE_ENV="development"
NEXT_PUBLIC_APP_NAME="Atlas"
