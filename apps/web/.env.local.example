# Atlas shell (apps/web) — local-dev env template.
#
# The shell rewrites /forge, /waf, /tap, /maturity, /people to per-module
# origins. In prod the supervisor (scripts/start-databricks-app.mjs)
# sets these to loopback ports; in local dev each module runs on its
# own port and the shell proxies to them.

ATLAS_FORGE_ORIGIN=http://localhost:3001
ATLAS_WAF_ORIGIN=http://localhost:3002
ATLAS_TAP_ORIGIN=http://localhost:3003
ATLAS_MATURITY_ORIGIN=http://localhost:3004
# Local Vite server. Production overrides this with FastAPI on loopback :3005.
ATLAS_PEOPLE_ORIGIN=http://localhost:3006
