# MAS (Maturity Assessment) — local-dev env template.
#
# In production these come from app.yaml (env + valueFrom resource
# bindings) — see resources/atlas.app.yml. For local dev, copy this
# file to apps/mas/.env.local and fill in the values.

# --- Lakebase (atlas-admin native_password) ---
# The MAS app writes to schema `mas` on the Atlas Lakebase Autoscale
# project (databricks-atlas).
LAKEBASE_POOLER_HOST=ep-young-darkness-e5p0ng50-pooler.database.brazilsouth.azuredatabricks.net
LAKEBASE_NATIVE_USER=atlas-admin
LAKEBASE_NATIVE_PASSWORD=
LAKEBASE_DATABASE=databricks_postgres

# Optional: cross-zone origin overrides (only used if MAS calls into
# another module, which it doesn't today).
# ATLAS_FORGE_ORIGIN=http://localhost:3001
# ATLAS_WAF_ORIGIN=http://localhost:3002
# ATLAS_TAP_ORIGIN=http://localhost:3003
