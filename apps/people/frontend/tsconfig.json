{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    // Pin react/react-dom type resolution to this module's @types/react@18
    // (apps/people/node_modules). Sibling Atlas modules use @types/react@19,
    // which npm hoists to the repo root; without this, react-router-dom's
    // .d.ts resolves the hoisted @18 vs @19 mismatch and emits TS2786
    // ("Routes/Route cannot be used as a JSX component"). Type-only remap:
    // vite uses its own resolver, so the runtime bundle is unaffected.
    "paths": {
      "@/*": ["./src/*"],
      "react": ["../node_modules/@types/react"],
      "react/*": ["../node_modules/@types/react/*"],
      "react-dom": ["../node_modules/@types/react-dom"],
      "react-dom/*": ["../node_modules/@types/react-dom/*"]
    }
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
