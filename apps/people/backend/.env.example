# ── Modo ──────────────────────────────────────────────────────────────────────
# true  = dev local sem Postgres/Databricks (usa seed/seed_data.json em memória)
# false = produção (Databricks Apps + Lakebase) ou host alternativo (AWS RDS)
MOCK_MODE=true
APP_ENV=development

# ── Postgres ────────────────────────────────────────────────────────────────────
# Lakebase Autoscaling: resource path completo do endpoint anexado ao app.
LAKEBASE_ENDPOINT_NAME=projects/<project>/branches/<branch>/endpoints/<endpoint>
PGHOST=<endpoint>.database.<region>.databricks.net
PGPORT=5432
PGDATABASE=databricks_postgres
PGUSER=
PGSSLMODE=require
PGSCHEMA=certifica
# Role nativo (Atlas/dev) tem precedência sobre OAuth quando PGPASSWORD existe.
PGPASSWORD=
# Host alternativo AWS RDS (opcional): senha estática OU auth IAM.
RDS_IAM_AUTH=false
AWS_REGION=us-east-1

# ── LLM: Databricks Foundation Model API ────────────────────────────────────────
# Injetados automaticamente em Databricks Apps. Fora do Databricks, use OAuth M2M.
DATABRICKS_HOST=https://<workspace>.cloud.databricks.com
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=
# Qualquer chat model do workspace (ex.: databricks-claude-opus-4-8, gpt-oss-120b).
LLM_ENDPOINT=databricks-claude-opus-4-8
# Alias aceito quando o endpoint vem de um app resource:
# SERVING_ENDPOINT_NAME=databricks-claude-opus-4-8

# ── Auth (JWT + bcrypt) ─────────────────────────────────────────────────────────
ENABLE_JWT_AUTH=true
# CERTIFICA_JWT_SECRET é o nome preferido no Atlas; JWT_SECRET também é aceito.
# Gere um valor aleatório antes de usar APP_ENV=production.
CERTIFICA_JWT_SECRET=
AUTH_HEADER=X-App-Auth
# Habilite somente atrás do proxy Databricks Apps, que injeta x-forwarded-email.
CERTIFICA_DATABRICKS_SSO_ENABLED=false
# Quem administra a plataforma (console /platform). Vírgula separa vários.
SUPERADMIN_EMAILS=
# Senha inicial do(s) superadmin(s) criada no seed. Não há valor padrão.
SEED_ADMIN_PASSWORD=
ALLOW_SELF_REGISTER=true
PASS_MARK=70

# ── Primeiro tenant (opcional) ────────────────────────────────────────────────
DEFAULT_TENANT_SLUG=
DEFAULT_TENANT_NAME=

# Em APP_ENV=production: configure um JWT secret seguro; SSO exige o tenant
# padrão; seed com SUPERADMIN_EMAILS exige SEED_ADMIN_PASSWORD explícito.

# ── App ──────────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# Seed idempotente no primeiro boot (schema + banco de questões + superadmin).
SEED_ON_STARTUP=false
# Origens permitidas (CORS).
CORS_ORIGINS=https://*.databricksapps.com,http://localhost:5173,http://localhost:3006
