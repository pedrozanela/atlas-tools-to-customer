{
  "name": "@atlas/people",
  "version": "1.0.0",
  "private": true,
  "description": "People & Training — Atlas People module",
  "type": "module",
  "scripts": {
    "dev": "vite --config frontend/vite.config.ts",
    "build": "npm run typecheck && vite build --config frontend/vite.config.ts",
    "lint": "npm run typecheck",
    "typecheck": "tsc -p frontend/tsconfig.json --noEmit",
    "test": "vitest run --config frontend/vitest.config.ts",
    "test:backend": "python3 -m pytest backend/tests",
    "clean": "node -e \"require('node:fs').rmSync('backend/static/assets',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@tanstack/react-query": "^5.40.0",
    "axios": "^1.7.2",
    "framer-motion": "^11.2.10",
    "lucide-react": "^0.379.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.23.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.4.5",
    "vite": "^5.3.1",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20"
  }
}
