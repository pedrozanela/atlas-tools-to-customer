# Required when not in mock mode
APP_COMPANY_NAME=
APP_COMPANY_INDUSTRY=

# Unity Catalog destination (Atlas convention: one catalog `databricks_atlas`,
# one schema per module).
UC_CATALOG=databricks_atlas
UC_SCHEMA=tap
UC_TABLE=databricks_tap_tool_submissions

# Databricks workspace (auto-injected when deployed as a Databricks App)
DATABRICKS_HOST=
DATABRICKS_WAREHOUSE_HTTP_PATH=

# When true, skip all UC writes (logs payload instead)
APP_DEV_MOCK_DATABASE=true

# Local-dev user identity (used when X-Forwarded-* headers are absent)
LOCAL_DEV_USER=local-dev@example.com
